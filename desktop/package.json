{
  "name": "streamboard-desktop",
  "productName": "StreamBoard IPTV",
  "version": "1.4.0",
  "private": true,
  "description": "StreamBoard IPTV Windows with persistent player, refined Windows UI, Playlist Studio and local HTTP/HTTPS HLS bridge",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "prepare-player": "node scripts/copy-hls.js",
    "dist:win": "npm run prepare-player && npm run verify:source && electron-builder --win nsis --x64 && npm run verify:packed",
    "verify:source": "node scripts/verify-source.js",
    "verify:packed": "node scripts/verify-packed.js"
  },
  "dependencies": {
    "hls.js": "1.6.12"
  },
  "devDependencies": {
    "electron": "35.2.2",
    "electron-builder": "25.1.8",
    "@electron/asar": "4.3.1"
  },
  "build": {
    "appId": "com.techboard.streamboard.desktop",
    "productName": "StreamBoard IPTV",
    "files": [
      "main.js",
      "preload.js",
      "stream-bridge.js",
      "repo-discovery.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "StreamBoard-IPTV-Setup-${version}.${ext}"
  }
}
